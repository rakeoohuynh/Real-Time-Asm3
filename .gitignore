# ---------------------------------------------------------------------
# QNX build outputs (QNX Recursive Makefile project structure creates
# per-CPU/per-variant build directories - these are regenerated by
# `make`, never hand-edited, so they don't belong in git)
# ---------------------------------------------------------------------
nto/
arm/
armv7/
armle-v7/
aarch64le/
x86_64/
o.le/
o.be/
*.o
*.obj
*.a
*.so
*.so.*
*.out
*.full
*.sym

# Windows debug symbols (MSVC/PDB - shows up when building/debugging
# on a Windows host, e.g. vc140.pdb)
*.pdb
*.ilk
*.exe
*.dll

# ---------------------------------------------------------------------
# VS Code - keep the SHARED config so the whole team builds/debugs the
# same way, ignore only the machine-local/auto-generated bits
# ---------------------------------------------------------------------
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
!.vscode/settings.json
.vscode/ipch/
.vscode/browse.vc.db*
.vscode/*.log

# C/C++ extension IntelliSense database (auto-generated, machine-local)
.vscode/.browse.VC.db*
ipch/

# ---------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------
# Editor backups / swap files
# ---------------------------------------------------------------------
*~
*.swp
*.bak