# Builds local_controller and central_controller.
#
#   make -f Makefile.poc              # both binaries, demo timing
#   make -f Makefile.poc SCALE=1      # real-world timing
#   make -f Makefile.poc clean
#
# This is separate from the Momentics Makefile in this directory, which
# builds one binary from every .c file and can't handle two programs
# with their own main(). Object files go next to their sources.

# Plain '=' on purpose: make predefines CC=cc, so '?=' would never take
# effect. `make CC=...` still overrides it.
CC      = qcc
TARGETV ?= -Vgcc_ntox86_64
SCALE   ?= 5

CFLAGS  = $(TARGETV) -Wall -Wextra -Wno-unused-parameter -DTIME_SCALE_FACTOR=$(SCALE) \
          -Ishared -Ilc -Icc
LDLIBS  = -lpthread -lsocket

LC_SRCS = \
	lc/local_controller.c \
	lc/lc_context.c \
	lc/phase_table.c \
	lc/signal_output.c \
	lc/boom_gate.c \
	lc/railway_protection.c \
	lc/train_schedule.c \
	lc/pedestrian.c \
	lc/fixed_timing.c \
	lc/sensor_driven.c \
	lc/mode_schedule.c \
	lc/right_turn.c \
	lc/status_report.c \
	lc/central_command_server.c \
	lc/console_input.c

CC_SRCS = cc/central_controller.c

LC_OBJS = $(LC_SRCS:.c=.o)
CC_OBJS = $(CC_SRCS:.c=.o)

HEADERS = $(wildcard shared/*.h lc/*.h cc/*.h)

all: local_controller central_controller

local_controller: $(LC_OBJS)
	$(CC) $(CFLAGS) -o $@ $(LC_OBJS) $(LDLIBS)

central_controller: $(CC_OBJS)
	$(CC) $(CFLAGS) -o $@ $(CC_OBJS) $(LDLIBS)

%.o: %.c $(HEADERS)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(LC_OBJS) $(CC_OBJS) local_controller central_controller

.PHONY: all clean