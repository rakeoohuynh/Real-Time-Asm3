# =====================================================================
# Makefile.poc -- builds the LC/CC proof-of-concept.
#
#   make -f Makefile.poc              # both binaries, demo timing
#   make -f Makefile.poc SCALE=1      # real-world timing (A40 off)
#   make -f Makefile.poc clean
#
# Kept separate from the Momentics recursive Makefile in this directory:
# that one builds a single target from the project folder, which cannot
# work for two programs with their own main(). See the note in README.md.
#
# Layout: shared/ (used by both programs), lc/ (Local Controller),
# cc/ (Central Controller). Objects are written next to their sources.
# =====================================================================

# Plain '=' not '?=': make predefines CC=cc, so '?=' would never apply.
# It can still be overridden on the command line (make CC=...).
CC      = qcc
TARGETV ?= -Vgcc_ntox86_64
SCALE   ?= 5

CFLAGS  = $(TARGETV) -Wall -Wextra -Wno-unused-parameter -DTIME_SCALE_FACTOR=$(SCALE) \
          -Ishared -Ilc -Icc
LDLIBS  = -lpthread -lsocket

LC_SRCS = \
	lc/local_controller.c \
	lc/lc_context.c \
	lc/phase_table.c \
	lc/signal_output.c \
	lc/boom_gate.c \
	lc/railway_protection.c \
	lc/train_schedule.c \
	lc/pedestrian.c \
	lc/fixed_timing.c \
	lc/sensor_driven.c \
	lc/right_turn.c \
	lc/status_report.c \
	lc/central_command_server.c \
	lc/console_input.c

CC_SRCS = cc/central_controller.c

LC_OBJS = $(LC_SRCS:.c=.o)
CC_OBJS = $(CC_SRCS:.c=.o)

HEADERS = $(wildcard shared/*.h lc/*.h cc/*.h)

all: local_controller central_controller

local_controller: $(LC_OBJS)
	$(CC) $(CFLAGS) -o $@ $(LC_OBJS) $(LDLIBS)

central_controller: $(CC_OBJS)
	$(CC) $(CFLAGS) -o $@ $(CC_OBJS) $(LDLIBS)

%.o: %.c $(HEADERS)
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(LC_OBJS) $(CC_OBJS) local_controller central_controller

.PHONY: all clean